# Copy to .env.local and fill in from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the login cookie. Any random string of 32+ characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Shows the "Next step (demo)" button on the live status screen so you can walk a wash through.
DEMO_MODE=true
